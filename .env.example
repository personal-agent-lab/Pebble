# Pebble 服务端配置
#
# 实例持久目录：SQLite、会话与资料文件都放在这里。
# 默认 <仓库根>/.data，直接复制本文件即可用；换部署位置时取消注释并改成绝对路径。
# PEBBLE_DATA_DIR=/absolute/path/to/.data

# 服务监听地址。手机访问需监听 0.0.0.0 并按设计第 6 节经 HTTPS 暴露。
PEBBLE_HOST=127.0.0.1
PEBBLE_PORT=8000

# 仅前端开发代理使用：Vite 把 /api 转发到这个地址，后端不在本机时改这里。
PEBBLE_BACKEND_URL=http://127.0.0.1:8000

# Gmail 凭证路径（可选）。若不配置，默认从 <PEBBLE_DATA_DIR>/credentials.json 读取。
# PEBBLE_GMAIL_CREDENTIALS_PATH=/absolute/path/to/credentials.json
# PEBBLE_GMAIL_TOKEN_PATH=/absolute/path/to/gmail_token.json

# 当前使用 Qoder CN（Token 在 https://qoder.cn/account/integrations 创建）
QODERCN_PERSONAL_ACCESS_TOKEN=
# 内置模型可省略模型名；BYOK 则必须配置模型名、目录中的 provider key 和 API Key。
# PEBBLE_QODER_MODEL=
# PEBBLE_MODEL_PROVIDER=
# PEBBLE_MODEL_API_KEY=
# PEBBLE_MODEL_BASE_URL=

# iCloud 单次日程创建（可选）：不配置时不影响现有邮件功能。
# App 专用密码单独保存为仅服务端用户可读的文件，不填写主账号密码、不提交密码文件。
# PEBBLE_ICLOUD_ACCOUNT=your-apple-account@example.com
# PEBBLE_ICLOUD_PASSWORD_PATH=/absolute/path/to/.data/icloud_app_password
# 固定目标日历的完整 CalDAV collection URL；不是公开订阅链接或 iCloud 网页地址。
# PEBBLE_ICLOUD_CALENDAR_URL=https://pXX-caldav.icloud.com/ACCOUNT/calendars/CALENDAR/
PEBBLE_ICLOUD_TIMEZONE=Australia/Adelaide
